# Hindsight Configuration
# Use Hindsight Cloud:
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# Or self-hosted:
# HINDSIGHT_BASE_URL=http://localhost:8888
# OPENAI_API_KEY=sk-xxx
# HINDSIGHT_API_LLM_API_KEY=sk-xxx

# Memory Bank
HINDSIGHT_BANK_ID=api-abuse-engine

# Server
PORT=3000

# Engine Tuning
SESSION_BUFFER_THRESHOLD=5
SESSION_TIMEOUT_MS=30000
BLOCK_SCORE=85
THROTTLE_SCORE=70
MONITOR_SCORE=40

# Cache
CACHE_TTL_MINUTES=5

# Firewall Ruleset
RULES_FILE_PATH=C:\path\to\rules.json

# Ollama AI Configuration
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ML Training Configuration
TRAINING_ENABLED=true
TRAINING_INTERVAL_HOURS=1
TRAINING_USE_INCREMENTAL=true
TRAINING_ENABLE_RULES_TRIGGER=true
TRAINING_RULES_THRESHOLD=5
TRAINING_FULL_RETRAIN_HOURS=24

# Ollama Auto-Analysis
OLLAMA_AUTO_ANALYZE=true
OLLAMA_ANALYZE_INTERVAL=30

# Logging Configuration
LOG_MAX_DAYS=7
LOG_MAX_SIZE_MB=100
LOG_CHUNK_SIZE_MB=4
